{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ReportSetting": {
    "OutputFolderName": "PowerReports",
    "ExtractIntervalMinutes": 5
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/PowerTraderRepGen-Service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],

    "Enrich": [
      "FromLogContext"
    ]
  }
}
